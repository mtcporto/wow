{
  "name": "azeroth-explorer",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "catalogue:update": "node --env-file=.env.local scripts/update-pet-catalogue.cjs",
    "mounts:update": "node --env-file=.env.local scripts/update-class-mounts.cjs",
    "media:update": "python3 scripts/update-media-catalogue.py",
    "icons:update": "node --env-file=.env.local scripts/update-spell-icons.cjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components features lib",
    "verify:http": "node scripts/verify-http.cjs",
    "build:local": "NEXT_PUBLIC_BASE_PATH=/wow NEXT_DIST_DIR=.next-local next build",
    "start:local": "NEXT_PUBLIC_BASE_PATH=/wow NEXT_DIST_DIR=.next-local next start --hostname 127.0.0.1 --port 8788",
    "maps:update": "python3 scripts/update-instance-maps.py",
    "toys:update": "node --env-file=.env.local scripts/update-toy-catalogue.cjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stream-json": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
